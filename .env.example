# Environment configuration for Chest X-ray Multi-Label Classification

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Model Selection
# Switch between "weighted_best.keras" and "finetuned_best.keras"
MODEL_PATH=weighted_best.keras
LABELS_PATH=labels.json
TRAINING_CONFIG_PATH=training_config.json

# Frontend Configuration
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=60
